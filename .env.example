# ============================================
# 简历雷达 环境变量配置
# 复制本文件为 .env.local 并填入你的配置
# ============================================

# DeepSeek API Key（可选）
# 不配置时自动降级为"规则评分"模式，仍可正常使用，但建议 AI 建议更智能
# 获取：https://platform.deepseek.com  → API Keys → 创建
DEEPSEEK_API_KEY=

# DeepSeek API 地址与模型（一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============================================
# 前端（浏览器端）配置，写入 .env.local 后 next build 时内联
# ============================================

# AI 代理地址（同源默认 /api/ai-proxy —— app/api/ai-proxy 路由，隐藏 DeepSeek Key）
# 一般不配置即用同源默认；仅当 AI 代理单独部署时用 NEXT_PUBLIC_AI_PROXY_URL 指向该地址
NEXT_PUBLIC_AI_PROXY_URL=/api/ai-proxy

# AI 代理共享密钥（P0 安全加固，必填生产环境）
# 与 Vercel 环境变量 AI_PROXY_SECRET 填【相同】的值。
# 前端把它内联进 JS 包、经 x-api-key 头携带，用于防止他人直接刷你的 AI 代理/DeepSeek 额度。
# 生成建议：openssl rand -hex 32
NEXT_PUBLIC_AI_PROXY_KEY=

# 埋点上报端点（可选）
# 配置后前端经 navigator.sendBeacon 上报事件；不配置则完全静默（no-op）
NEXT_PUBLIC_TRACKING_URL=

# ============================================
# Vercel 环境变量（项目设置 → Environment Variables），对应用内 app/api/ai-proxy 路由
# ============================================
# DEEPSEEK_API_KEY  —— DeepSeek 密钥（服务端持有，前端永远拿不到）
# DEEPSEEK_BASE_URL —— DeepSeek 接口地址（默认 https://api.deepseek.com）
# DEEPSEEK_MODEL    —— DeepSeek 模型（默认 deepseek-chat）
# AI_PROXY_SECRET   —— 与上面 NEXT_PUBLIC_AI_PROXY_KEY 同值；路由侧校验，缺失/不匹配返回 401。
#                       ★ 务必配置，否则任何人都可无偿调用烧你的 DeepSeek 额度。
# AI_PROXY_ALLOWED_ORIGINS —— 可选，逗号分隔的 Origin 白名单（完整 Origin / 裸主机名 localhost / *.suffix）。
#                              为空时不限制 Origin（向后兼容）；正式域名确认后务必配置收紧。
# 备注：云同步（sync/syncClear）已在此部署降级为本地，未托管云同步数据库。
# 小程序侧对应变量：在 Taro 构建环境注入 AI_PROXY_KEY（与上面同值），并让 NEXT_PUBLIC_AI_PROXY_URL 指向该独立代理。

