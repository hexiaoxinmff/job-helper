# ============================================
# 简历雷达 环境变量配置
# 复制本文件为 .env.local 并填入你的配置
# ============================================

# DeepSeek API Key（可选）
# 不配置时自动降级为"规则评分"模式，仍可正常使用，但建议 AI 建议更智能
# 获取：https://platform.deepseek.com  → API Keys → 创建
DEEPSEEK_API_KEY=

# DeepSeek API 地址与模型（一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============================================
# 前端（浏览器端）配置，写入 .env.local 后 next build 时内联
# ============================================

# AI 代理云函数地址（CloudBase HTTP 函数网关地址，隐藏 DeepSeek Key）
# 前端所有 AI 调用都打到这个地址；不配置时使用代码内默认地址
NEXT_PUBLIC_AI_PROXY_URL=

# AI 代理共享密钥（P0 安全加固，必填生产环境）
# 与云函数环境变量 AI_PROXY_SECRET 填【相同】的值。
# 前端把它内联进 JS 包、经 x-api-key 头携带，用于防止他人直接刷你的云函数/DeepSeek 额度。
# 生成建议：openssl rand -hex 32
NEXT_PUBLIC_AI_PROXY_KEY=

# 埋点上报端点（可选）
# 配置后前端经 navigator.sendBeacon 上报事件；不配置则完全静默（no-op）
NEXT_PUBLIC_TRACKING_URL=

# ============================================
# 云函数（cloudfunctions/ai-proxy）环境变量，在 CloudBase 控制台配置
# ============================================
# AI_PROXY_SECRET         —— 与上面 NEXT_PUBLIC_AI_PROXY_KEY 同值；云函数侧校验，缺失/不匹配返回 401。
#                              ★ 务必配置，否则任何人都可无偿调用烧你的 DeepSeek 额度。
# AI_PROXY_ALLOWED_ORIGINS —— 可选，逗号分隔的 Origin 白名单。支持三种规则：
#                              · 完整 Origin：https://你的域名（精确匹配 scheme+host+port）
#                              · 裸主机名：localhost（匹配任意端口本地开发）
#                              · 通配子域：*.example.com（边界安全，防后缀伪装）
#                              为空时不限制 Origin（向后兼容）；正式域名确认后务必配置收紧。
# 小程序侧对应变量：在 Taro 构建环境注入 AI_PROXY_KEY（与上面同值），否则小程序请求会被 401 拒绝。

